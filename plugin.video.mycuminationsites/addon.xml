<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.mycuminationsites" name="MyCumination" version="4.1.0" provider-name="Denise">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests"/>
        <import addon="script.module.beautifulsoup4"/>
        <import addon="script.module.cloudscraper" optional="true"/>
        <import addon="script.module.resolveurl" optional="true"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="de">MyCumination Addon</summary>
        <description lang="de">Video Addon mit Cloudflare Bypass Support.</description>
        <platform>all</platform>
    </extension>
</addon>
