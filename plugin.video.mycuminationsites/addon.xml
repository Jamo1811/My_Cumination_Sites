<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.mycumination" name="MyCumination" version="2.2.0" provider-name="Denise">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests"/>
        <import addon="script.module.beautifulsoup4"/>
        <import addon="script.module.resolveurl" optional="true"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="de">MyCumination Kodi Video Addon</summary>
        <description lang="de">Video Scraper für Darknessporn mit automatischer Hoster-Auflösung via ResolveURL.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
